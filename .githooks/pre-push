#!/usr/bin/env bash
# pre-push — refuse un push de branche qui modifie un fichier SERVI sans bumper
# `CACHE_NAME` dans sw.js (CLAUDE.md § Versionnement). Sans bump, la PWA
# installée continue de servir les anciens fichiers, sans rien dire.
#
# Jugé sur toute la BRANCHE (merge-base avec origin/main → tête poussée), pas
# par commit : la règle dit « même PR », et un bump dans son propre commit est
# sain (un garde par commit a été écarté le 2026-09-25 dans plex-jqh-omv :
# rejoué sur l'historique, il bloquait 3 PR saines).
#
# Hook git et non hook Claude : ce repo est surtout édité depuis des sessions
# knowledge-base, où un hook .claude/settings.json d'ici ne se charge jamais.
# Activation (par clone) : git config core.hooksPath .githooks
# Contournement assumé : git push --no-verify
set -uo pipefail

# Servi = ce que la PWA embarque. Non servi : sync/ (serveur), tests, outillage,
# fichiers cachés, prose.
served_files() {
  awk 'NF && !/^(sync|tests|\.claude|\.github|\.githooks)\// && !/^\./ \
       && !/\.md$/ && $0 != "LICENSE"'
}

rc=0
while read -r _lref lsha _rref _rsha; do
  case "$lsha" in *[!0]*) ;; *) continue ;; esac       # suppression de branche
  base="$(git merge-base origin/main "$lsha" 2>/dev/null)" || continue
  served="$(git diff --name-only "$base" "$lsha" | served_files)"
  [ -z "$served" ] && continue
  git diff -U0 "$base" "$lsha" -- sw.js |
    awk '/^\+[^+]/ && /CACHE(_NAME)?[[:space:]]*=/ { f = 1 } END { exit !f }' && continue
  {
    echo "✗ pre-push : fichier(s) servi(s) modifié(s) sans bump de CACHE_NAME dans sw.js :"
    printf '%s\n' "$served" | sed 's/^/    /'
    echo "  Bumper sw.js : const CACHE_NAME = 'pock-v<N+1>'."
    echo "  Contournement seulement si voulu : git push --no-verify"
  } >&2
  rc=1
done
exit "$rc"
